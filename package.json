{
  "name": "quick-apply-autofill",
  "version": "1.2.0",
  "private": true,
  "description": "Quick Apply (Autofill) browser extension. TypeScript sources in src/, loadable extension built into dist/.",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "watch": "node scripts/copy-assets.mjs && tsc --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build && node test/fill-engine.test.ts",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "playwright": "^1.49.0",
    "typescript": "^5.7.0"
  },
  "type": "module"
}
