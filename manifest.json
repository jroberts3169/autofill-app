{
  "manifest_version": 3,
  "name": "Ashby Quick Apply (Autofill)",
  "version": "1.0.0",
  "description": "Autofills your info on AshbyHQ job application forms. Fill-only — you always review and click submit yourself.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["*://*.ashbyhq.com/*"],
  "action": {
    "default_title": "Ashby Quick Apply",
    "default_popup": "src/popup.html"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["*://*.ashbyhq.com/*"],
      "js": ["src/common.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ashby-quick-apply@local",
      "strict_min_version": "115.0"
    }
  }
}
