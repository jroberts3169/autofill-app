{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    // Classic scripts, not modules: the manifest loads common.js and
    // content.js as separate <script>s sharing one global scope, so no file
    // here may contain a top-level import/export.
    "module": "none",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "newLine": "lf",
    "skipLibCheck": true,
    "types": ["chrome"]
  },
  "include": ["src/**/*.ts"]
}
